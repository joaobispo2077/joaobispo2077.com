    "@vercel/analytics": "^1.0.0",
    "cross-env": "^7.0.3",
    "framer-motion": "^6.5.1",
    "graphql": "^16.6.0",
    "gray-matter": "4.0.3",
    "marked": "18.0.0",
    "next": "^12.3.1",
    "pino": "8.21.0",
    "pino-pretty": "13.1.3",
    "react": "^18.2.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "^18.2.0",
    "react-icons": "^4.4.0",
    "react-syntax-highlighter": "^15.5.0",
    "urql": "^3.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^16.2.4",
    "@commitlint/config-conventional": "^16.2.4",
